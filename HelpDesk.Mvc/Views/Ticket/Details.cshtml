@model HelpDesk.Mvc.Models.TicketCreateEditViewModel

@{
    ViewData["Title"] = "Ticket Details";
}

<div class="container mt-4">
    <h2 class="text-primary fw-bold mb-4">Ticket Details</h2>

    <div class="card shadow col-md-6 p-4">
        <dl class="row mb-0">
            <dt class="col-sm-4">Title</dt>
            <dd class="col-sm-8">@Model.Title</dd>

            <dt class="col-sm-4">Description</dt>
            <dd class="col-sm-8">@Model.Description</dd>

            <dt class="col-sm-4">Raised By</dt>
            <dd class="col-sm-8">@Model.RaisedBy</dd>

            <dt class="col-sm-4">Priority</dt>
            <dd class="col-sm-8">@Model.Priority</dd>

            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">@Model.Status</dd>

            <dt class="col-sm-4">Created</dt>
            <dd class="col-sm-8">@Model.CreatedDate.ToString("g")</dd>
        </dl>
    </div>

    <div class="mt-3">
        <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
    </div>
</div>
