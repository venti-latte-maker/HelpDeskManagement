@model HelpDesk.Mvc.Models.TicketCreateEditViewModel

@{
    ViewData["Title"] = "Delete Ticket";
}

<div class="container mt-4">
    <h2 class="text-danger fw-bold mb-4">Delete Ticket</h2>

    <div class="alert alert-warning">
        Are you sure you want to delete this ticket? This action cannot be undone.
    </div>

    <div class="card shadow col-md-6 p-4">
        <dl class="row mb-0">
            <dt class="col-sm-4">Title</dt>
            <dd class="col-sm-8">@Model.Title</dd>

            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">@Model.Status</dd>

            <dt class="col-sm-4">Priority</dt>
            <dd class="col-sm-8">@Model.Priority</dd>

            <dt class="col-sm-4">Raised By</dt>
            <dd class="col-sm-8">@Model.RaisedBy</dd>
        </dl>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
